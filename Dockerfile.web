# OmniTest 前端镜像（构建 Vite 产物 → nginx 托管）
#
# 产物发布到 nginx 默认站点目录；/api 与 /uploads 反代到同 compose 网络的 backend。
# 构建上下文是**项目根**（docker-compose.yml 所在目录），故 web/ 路径均带前缀。
# ⚠️ Node 必须 ≥22.22.0：react-router@8.4.0 声明 engines.node >=22.22.0，
#    用 node:20 会触发 EBADENGINE（本例虽仍能构建，但属版本不符，明确对齐）。
FROM node:22-bookworm-slim AS build

WORKDIR /src

# 先装依赖，利用镜像层缓存
COPY web/package*.json ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# 再拷前端源码并构建（tsc -b && vite build）
COPY web/ ./
RUN npm run build

# ---- 运行阶段 ----
FROM nginx:1.27-alpine

ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=5 --start-period=20s \
    CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
