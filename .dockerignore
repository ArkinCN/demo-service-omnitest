# OmniTest 部署包 .dockerignore
# 构建上下文 = 项目根。排除大体积、无关或含凭据的内容。
#
# ⚠️ 注意：不要排除 web/，前端构建需要它。
# 也不要排除 web/public/（场景包与知识库静态数据，构建产物依赖）。

# 依赖与构建产物
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
web/dist/
**/dist/
**/build/

# 环境与凭据
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
id_rsa*

# 运行期数据（由 compose 卷挂载）
backend/.deploy/
backend/uploads/
**/logs/
*.log

# 版本控制与编辑器
.git/
.gitignore
.idea/
.vscode/
**/.DS_Store
**/Thumbs.db

# 截图与排障残留（不影响运行）
web/shots/
web/shots2/
web/scripts/_diag_*.mjs
**/_dump*.txt
**/_probe_out*.txt
backend/_pip_before.txt
backend/_run.json
backend/_uv.log
backend/uvicorn_*.log
backend/backend_start.log
kb-pipeline/
docs/
