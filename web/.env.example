# ===========================================================================
# 前端环境变量清单。复制成 .env 后按本机实际情况改，改完必须重启 vite——
# Vite 不热加载环境变量。只有 VITE_ 前缀的变量会进浏览器包，所以这里不能放
# 任何私钥本体；私钥只以「环境变量名」的形式出现在服务端配置里。
# ===========================================================================

# --- 助手后端 --------------------------------------------------------------
# mock = 本地脚本回放（默认，用于演示截图）；dsh = 真实后端
# （POST /api/agent/stream + /api/agent/confirm，经 vite 的 /api 代理打到 8011）。
# 改完必须重启 vite——环境变量不热加载。
VITE_AGENT_BACKEND=mock

# --- 设备桥（[源] spike-device-mcp/bridge.py，FastAPI）--------------------
# 画布设备节点的状态、分层工具菜单、红线动作的 confirm_token 都走它。
# 起桥：cd [源] lab/spike-device-mcp && ./run-bridge.sh
VITE_DEVICE_BRIDGE_URL=http://127.0.0.1:8031
# 与桥自己 .env 里的 BRIDGE_TOKEN 同值。桥在 BRIDGE_TOKEN 未设置时拒绝启动；
# 前端这一侧没配则所有请求被 401，设备节点显示「网关未连通」并说明缺这一项。
#
# 【口径 · 2026-09-20 改】这是一张**调用票，不是批准权**。它一定会被打进
# dist 的 JS，任何拿到构建产物的人都能读到，所以按公开处理。持有它能做的事：
# 列设备、查状态、调工具（红线工具会被桥拒绝并签发一张 pending 凭据）、驳回凭据。
# 持有它**不能**做的事：把凭据从 pending 推到 approved——批准另要一个秘密
# BRIDGE_APPROVER_PIN，只配在桥的 .env 里，由人在确认卡上现场输入。
# 本文件里不会、也不允许出现任何名为 VITE_*_PIN 的变量。
VITE_BRIDGE_TOKEN=
# 自动化自动放行的调用票（一键自动化测试流程用，2026-09-30 加）。
# 【定位】与桥 .env 的 BRIDGE_AUTOMATION_TOKEN 同值。仅 dev 模式随包进浏览器
# （import.meta.env.DEV 在 build 时被消除，dist 不内嵌）；它只用于「自动化流程
# 无 PIN 放行 start/stop」，不替代 BRIDGE_APPROVER_PIN（人工批准仍走 PIN）。
# 桥未配置 BRIDGE_AUTOMATION_TOKEN 时，自动化「测试执行」阶段会如实失败，
# 不会静默降级成「电机已转」。
VITE_AUTOMATION_TOKEN=

# 桥默认只放行 http://localhost:5173 与 http://localhost:3080 两个来源。
# 前端跑在别的端口（例如 npm run preview 的 4199）时，要在桥那侧把端口加进
# BRIDGE_CORS_ORIGIN，否则浏览器直接拦掉，页面上看不到任何错误。

# --- SSH 网关（[源] lab/webssh）----------------------------------------------
# 第四轮起只剩「命令行会话」一个用途：设备节点放大态里那个 xterm 终端。
# 该分支已被交付包标为「建议废弃，仅供参考」，不起它不影响设备节点状态。
VITE_GATEWAY_URL=http://localhost:8022
VITE_GATEWAY_TOKEN=

# --- 台架工控机的连接信息（2026-09-23 从代码里外置）------------------------
# 原先写死在 src/features/remote/device.ts：host=172.25.5.166、port=5011、
# user=administrator、取图目录 C:\fc_pull。
# 三项理由必须外置：
#   一、地址与账号随台架环境变，写死换一台机器就失效；
#   二、把客户内网 IP 留在交付代码里不合脱敏要求；
#   三、取图目录是盘符路径，盘符在不同机器上不一样。
# 留空时的行为：地址/账号为空（界面如实显示未配置），取图目录为空则
# **不生成「取图目录」这条预设命令**——宁可不显示，也不拼一个空的 `dir `。
VITE_BENCH_HOST=
VITE_BENCH_PORT=22
VITE_BENCH_USER=
VITE_BENCH_PULL_DIR=
