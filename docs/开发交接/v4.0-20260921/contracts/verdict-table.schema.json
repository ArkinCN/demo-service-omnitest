{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict-table/v1",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "baseline_id",
    "overall",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "verdict-table/v1"
    },
    "run_id": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string"
    },
    "overall": {
      "type": "object",
      "required": [
        "result",
        "rule_expression"
      ],
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail",
            "pending"
          ]
        },
        "rule_expression": {
          "type": "string",
          "description": "照抄需求基线的 verdict_rule"
        },
        "fatal_total": {
          "type": "integer"
        },
        "fatal_passed": {
          "type": "integer"
        },
        "major_pass_rate": {
          "type": "number"
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "level",
          "result",
          "measured",
          "threshold"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "enum": [
              "fatal",
              "major",
              "minor"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "pending",
              "not-applicable"
            ]
          },
          "measured": {
            "description": "实测值；报告里出现的每个数值都必须能经这里回溯到 raw_data"
          },
          "threshold": {},
          "unit": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "object",
            "description": "这个实测值算自哪份原始数据的哪一段",
            "properties": {
              "raw_data_id": {
                "type": "string"
              },
              "t_start_ms": {
                "type": "number"
              },
              "t_end_ms": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
