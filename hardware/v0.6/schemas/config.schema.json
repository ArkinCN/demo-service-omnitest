{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Fan experiment editable configuration 1.0",
  "type":"object","required":["schemaVersion","serial","experiment","output","scope"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "serial":{"type":"object","required":["port","baud","expectedIdentity","wiringConfirmed"],"properties":{"port":{"type":"string","pattern":"^COM[1-9][0-9]*$"},"baud":{"const":115200},"expectedIdentity":{"const":"READY UNO_FAN_V2 25000"},"wiringConfirmed":{"type":"boolean"}}},
    "experiment":{"type":"object","required":["dutiesPercent","holdSeconds","cycles","settleSeconds"],"properties":{"dutiesPercent":{"type":"array","minItems":1,"items":{"type":"integer","minimum":0,"maximum":100}},"holdSeconds":{"type":"number","minimum":0.1,"maximum":3600},"cycles":{"type":"integer","minimum":0,"maximum":1000000},"settleSeconds":{"type":"number","minimum":0}}},
    "output":{"type":"object","required":["root"],"properties":{"root":{"type":"string","minLength":1}}},
    "scope":{"type":"object","required":["enabled","resource","expectedIdentity","inputImpedanceOhm","pwmTimebaseSecondsPerDiv","triggerLevelV","channels","currentConversion","tach"],"properties":{
      "enabled":{"type":"boolean"},"resource":{"type":"string"},"expectedIdentity":{"type":"string"},"inputImpedanceOhm":{"const":1000000},"pwmTimebaseSecondsPerDiv":{"type":"number","exclusiveMinimum":0,"maximum":0.00005},"triggerLevelV":{"type":"number"},
      "channels":{"type":"object","required":["current","voltage","pwm"],"properties":{"current":{"$ref":"#/$defs/channel"},"voltage":{"$ref":"#/$defs/channel"},"pwm":{"$ref":"#/$defs/channel"}}},
      "currentConversion":{"type":"object","required":["enabled","gainAmpsPerVolt","turns","lowRangeConfirmed","zeroConfirmed","singleConductorConfirmed","minimumSpecifiedCurrentA"],"properties":{"enabled":{"type":"boolean"},"gainAmpsPerVolt":{"type":"number","exclusiveMinimum":0},"turns":{"type":"integer","minimum":1},"lowRangeConfirmed":{"type":"boolean"},"zeroConfirmed":{"type":"boolean"},"singleConductorConfirmed":{"type":"boolean"},"minimumSpecifiedCurrentA":{"type":"number","minimum":0}}},
      "tach":{"type":"object","required":["enabled","channel","sensorModel","supplyVoltageV","signalWire","outputVoltageV","outputType","wiringConfirmed","probeRatio","physicalProbeRatioConfirmed","pulsesPerRevolution","timebaseSecondsPerDiv","scaleVoltsPerDiv","triggerLevelV"],"properties":{"enabled":{"type":"boolean"},"channel":{"type":"integer","minimum":1,"maximum":4},"sensorModel":{"type":["string","null"]},"supplyVoltageV":{"type":["number","null"]},"signalWire":{"type":["string","null"]},"outputVoltageV":{"type":["number","null"]},"outputType":{"type":["string","null"]},"wiringConfirmed":{"type":"boolean"},"probeRatio":{"type":["number","null"]},"physicalProbeRatioConfirmed":{"type":"boolean"},"pulsesPerRevolution":{"type":["integer","null"],"minimum":1},"timebaseSecondsPerDiv":{"type":"number","minimum":0.01,"maximum":0.1},"scaleVoltsPerDiv":{"type":["number","null"]},"triggerLevelV":{"type":["number","null"]}}}
    }}
  },
  "$defs":{"channel":{"type":"object","required":["channel","probeRatio","coupling","scaleVoltsPerDiv","offsetV","physicalProbeRatioConfirmed"],"properties":{"channel":{"type":"integer","minimum":1,"maximum":4},"probeRatio":{"enum":[1,10,100]},"coupling":{"const":"DC"},"scaleVoltsPerDiv":{"type":"number","exclusiveMinimum":0},"offsetV":{"type":"number"},"physicalProbeRatioConfirmed":{"type":"boolean"}}}}
}
