# MotorDebug 业务后端环境变量示例
#
# 用法：复制为 .env 后逐项填写。.env 绝不进版本控制。
# 纪律：本文件只留变量名与安全示例，不写任何真实凭据、内网地址或人名。

# ── 应用环境 ──
ENVIRONMENT=development
APP_NAME="MotorDebug Backend"
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# ── 安全密钥（必填，长度 >= 32）──
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 数据库 ──
# 本地单机验证用 SQLite（免装 MySQL）；生产用 MySQL。
# SQLite：sqlite:///.deploy/motordebug.db
# MySQL ：mysql+pymysql://<user>:<password>@127.0.0.1:3306/<dbname>
DATABASE_URL=sqlite:///.deploy/motordebug.db

# ── LDAP（本地不启用时保持占位即可）──
LDAP_URL=ldap://127.0.0.1:389
LDAP_ADMIN_DN=cn=Manager,dc=example,dc=internal
LDAP_ADMIN_PASSWORD=CHANGE_ME
LDAP_SEARCH_BASE=ou=示例,dc=example,dc=internal

# ── CORS（必须是 JSON 数组，否则 pydantic-settings 解析会崩）──
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8011"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ── 日志 ──
LOG_LEVEL=INFO
LOG_DIR=.deploy/logs

# ── 分页 ──
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── 文件上传 ──
UPLOAD_FOLDER=uploads/avatars
MAX_AVATAR_SIZE=5242880
SERVER_BASE_URL=http://127.0.0.1:8011
DOWNLOAD_PUBLIC_BASE_URL=http://127.0.0.1:8011

# ── 无密码模式（本地单机演示用）──
# true  ：跳过一切鉴权，所有请求以本地管理员身份执行。
#         ⚠️ 仅限单机内网演示，联网服务端必须为 false。
#         ⚠️ 阶段 2 验收「另一无权限用户读不到该任务」需切为 false。
AUTH_DISABLED=false
AUTH_DISABLED_USERNAME=admin
AUTH_DISABLED_EMAIL=admin@example.internal

# ── 大模型渠道（OpenRouter 中转）──
# ⚠️ 不要在此写真实 key。key 只写在 .env 里，且 .env 不进版本控制。
#
# 【2026-09-23 改】上游由 DeepSeek 官方改为 OpenRouter 中转，
# 模型取 deepseek/deepseek-v4.1-flash（支持 tools / 1M 上下文 / OpenAI 兼容）。
# 走第三方中转意味着请求会经 OpenRouter 再转发给其挂载的服务商，
# 场景包内容（含客户信息）会多经一层——交付前需客户书面认可。
# ⚠️ base_url **不要带 /v1**：网关已自带 /v1/chat/completions，
# 这里再带 /v1 会拼成 /api/v1/v1/... → 404。OpenRouter 文档给的是带 /v1 的形式，
# 但本工程要的是去掉 /v1 的前缀。
MOTORDEBUG_LLM_API_KEY=CHANGE_ME
MOTORDEBUG_LLM_BASE_URL=https://openrouter.ai/api
MOTORDEBUG_LLM_MODEL=deepseek/deepseek-v4.1-flash

# 便宜档上游模型名。**必须写上游真实模型名**，不是网关展示名。
# OpenRouter 上不存在 deepseek-flash，留空即自动复用 MOTORDEBUG_LLM_MODEL。
MOTORDEBUG_LLM_FAST_MODEL=

# ── 检索工具后端 ──
# KnowledgeSearch 有两条后端，用 KB_BACKEND 切换：
#   local  = 走本进程内的 BM25，语料是前端 public/kb/ 下的流水线产物（默认）
#   remote = 走下面的内网精简检索服务（需要能访问该内网地址）
# 单机/离线部署必须用 local，否则助手每次都会回「知识库连接异常」。
KB_BACKEND=local

# 以下三项仅在 KB_BACKEND=remote 时生效（单机版不可达，故超时压短快速降级）
KB_SEARCH_BASE_URL=https://kb.example.internal:14580
KB_SEARCH_API_KEY=
KB_SEARCH_TIMEOUT=3.0
DOC_LIBRARY_TIMEOUT=3.0

# ── 邮件（SMTP，可选）──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=CHANGE_ME
SMTP_USE_SSL=True
SMTP_FROM_NAME=MotorDebug
SMTP_FROM_EMAIL=

# ── 邀请码 ──
REQUIRE_INVITATION_CODE=True
