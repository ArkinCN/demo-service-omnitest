# device-bench MCP spike —— 凭据与端口
# 私钥【文件路径】，不是私钥本体；与 [源] lab/webssh 的 keyRef 同一约定
FORTIOR_WIN_KEY=[源] .ssh/fortior_win

BENCH_HOST=172.25.5.166
BENCH_PORT=5011
BENCH_USER=administrator
BENCH_SSH_TIMEOUT=12
BENCH_EXEC_TIMEOUT=60

# HTTP 桥
BRIDGE_PORT=8031
# 桥的共享鉴权 token；留空则桥拒绝启动。
# 【定位】这是"调用票"，不是批准权。它会随前端的 VITE_BRIDGE_TOKEN 被打进浏览器包，
# 任何拿到构建产物的人都能读到，所以只当它是公开的：持有它最多能列设备、查状态、
# 调工具（红线工具会被拒绝并签发一张 pending 凭据）、驳回凭据。
BRIDGE_TOKEN=change-me-to-a-long-random-string

# 批准 PIN：红线动作从 pending 推到 approved 的唯一钥匙，必须与 BRIDGE_TOKEN 不同值。
# 【定位】只存在于本文件与桥进程内存。绝不允许出现在前端的任何 VITE_ 变量里——
# VITE_ 前缀的变量一律进浏览器包，等于把批准权公开。人在确认卡上现场输入，
# 前端以 x-approver-pin 头随 approve 请求发出，用完即弃，不写 localStorage。
# 留空则桥拒绝启动。
BRIDGE_APPROVER_PIN=change-me-to-a-different-long-random-string
# 连续输错几次锁定、锁多少秒
BRIDGE_APPROVER_PIN_MAX_FAILS=5
BRIDGE_APPROVER_PIN_LOCK_SECONDS=60

# 自动化自动放行 token（一键自动化测试流程用，2026-09-30 加）。
# 【定位】与 BRIDGE_APPROVER_PIN 同级秘密：只存在于本文件与桥进程内存，绝不进浏览器包。
# 前端以 x-automation-token 头调 POST /confirmations/{token}/auto-approve 时，
# 凭据 approve_channel 记 "automation"（区别于 human_pin），留痕可审计。
# 缺省为空 = **关闭**自动化自动放行（红线仍只走人工 PIN）。要「真下发设备启动
# 无需人工」时才配它，且必须与 BRIDGE_TOKEN / BRIDGE_APPROVER_PIN 都不同值。
BRIDGE_AUTOMATION_TOKEN=

# MCP streamable-http 传输端口
MCP_HTTP_PORT=8032
