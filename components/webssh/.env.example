# ---- 网关（gateway/server.js 读取，dotenv） ----
GATEWAY_PORT=8022
# 浏览器访问网关所需的 token；随便一串长随机字符串，前后端必须一致
GATEWAY_TOKEN=change-me-to-a-long-random-string
GATEWAY_LOG_DIR=logs
GATEWAY_CORS_ORIGIN=http://localhost:5173

# ---- 私钥 ----
# devices.json 里每台设备的 keyRef 写的是"环境变量名"，这里给出该变量指向的私钥【文件路径】。
# 私钥本体不入库、不入环境变量、不进前端。
FORTIOR_WIN_KEY=[源] .ssh/fortior_win

# ---- 前端（Vite，VITE_ 前缀才会注入浏览器） ----
VITE_GATEWAY_URL=http://localhost:8022
VITE_GATEWAY_TOKEN=change-me-to-a-long-random-string
